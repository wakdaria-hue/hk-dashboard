# Copy this file to .streamlit/secrets.toml for local runs (never commit the real
# secrets.toml - it's already in .gitignore). On Streamlit Community Cloud, paste
# the same content into your app's Settings -> Secrets instead of using this file.

rate_store_spreadsheet_id = "PASTE_THE_RATE_HISTORY_GOOGLE_SHEET_ID_HERE"

# A SEPARATE Google Sheet from the rate-history one above (see README "HK
# Hours Self-Confirmation" section) - keeps payroll rate data out of the
# public-facing confirm_app.py's secrets. Same service account, shared as
# Editor.
confirmation_spreadsheet_id = "PASTE_THE_HK_HOURS_CONFIRMATION_GOOGLE_SHEET_ID_HERE"

# The full JSON key downloaded when you created the Google Cloud service account.
# Paste it here as a TOML table (same keys as the JSON file).
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
